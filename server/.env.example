# Telegram bot token (или переменная окружения GHOST_GIFT_BOT_TOKEN)
BOT_TOKEN=

# HTTP
PORT=8787
# Необязательный секрет заголовка X-Telegram-Bot-Api-Secret-Token, когда вебхук будет настроен позже
WEBHOOK_SECRET=

# Свежесть initData, секунды (по умолчанию 24 часа)
AUTH_MAX_AGE_SEC=86400

# Банк и лимиты
BANK_START=10000
BANK_RESERVE=3000
DAILY_BIG_PRIZE_CAP=8
BIG_PRIZE_MIN_VALUE=250

# Выводы: крупнее этого значения (в Stars) идут на проверку
WITHDRAW_REVIEW_MIN=250
NEW_ACCOUNT_HOURS=48
REVIEW_RISK_SCORE=60

# Антиабьюз
RATE_LIMIT_PER_MIN=40
OPEN_LIMIT_PER_MIN=20
AUTOCLICK_MIN_MS=450
AUTOCLICK_REGULAR_STDDEV_MS=25

# Путь к SQLite (по умолчанию ./data/ghost-gift.db)
# DATABASE_PATH=./data/ghost-gift.db
