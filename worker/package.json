{
  "name": "ghost-gift-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ghost-gift --local",
    "db:migrate:remote": "wrangler d1 migrations apply ghost-gift --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sim": "node --experimental-strip-types scripts/sim.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.3",
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.163.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261116.1": true
  }
}
